{
  "name": "@sj-ui-sdk/sj-ui",
  "version": "0.1.0",
  "private": true,
  "description": "SJ:s komponenter byggda på UI SDK, utan MUI. Pilot.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./button": "./src/components/button/button.tsx",
    "./switch": "./src/components/switch/switch.tsx",
    "./select": "./src/components/select/select.tsx",
    "./date-picker": "./src/components/date-picker/date-picker.tsx",
    "./departure-card": "./src/components/departure-card/departure-card.tsx",
    "./typography": "./src/components/typography/typography.tsx",
    "./icons": "./src/icons/index.tsx",
    "./agent": "./src/agent/index.ts",
    "./legacy/*": "./src/legacy/*.tsx",
    "./legacy.css": "./src/legacy/legacy.css"
  },
  "scripts": {
    "sync": "node scripts/sync-tokens.mjs && node scripts/sync-icons.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.4"
  }
}
