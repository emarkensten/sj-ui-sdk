{
  "name": "sj-ui-storybook",
  "private": true,
  "type": "module",
  "description": "Showcase for SJ's design-system team: KB (MUI) and sj-ui (UI SDK) side by side. Separate project because it installs KB from Bit.",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@mui/utils": "^7.3.11",
    "@sj-ab/component-library.styles.themes": "^15.0.2",
    "@sj-ab/component-library.ui.date-picker": "^12.0.13",
    "@sj-ab/component-library.ui.departure-card": "^7.4.1",
    "@sj-ab/component-library.ui.flow-button": "^8.0.1",
    "@sj-ab/component-library.ui.form-control-label": "^5.1.24",
    "@sj-ab/component-library.ui.icons": "^5.7.3",
    "@sj-ab/component-library.ui.localization-provider": "^1.0.37",
    "@sj-ab/component-library.ui.menu-item": "^6.0.43",
    "@sj-ab/component-library.ui.select": "^12.1.8",
    "@sj-ab/component-library.ui.switch": "^6.0.24",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.8",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "storybook": "10.6.8",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
